# Server
PORT=8080

# Database and authentication
MONGO_URI=mongodb://127.0.0.1:27017/secondBrain
JWT_SECRETE=replace-with-a-long-random-secret

# Google sign-in (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI must be exactly:
#   http://localhost:8080/api/v1/user/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/user/google/callback
FRONTEND_URL=http://localhost:3000

# Extra allowed CORS origins, comma separated (optional)
# CORS_ORIGINS=https://your-frontend.vercel.app

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# Pinecone vector search
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-index-name
PINECONE_URL=your-index-host-url
